{
  "backend": "tokenizers",
  "cls_token": "[CLS]",
  "do_lower_case": true,
  "extra_special_tokens": [
    "[COURSE]",
    "[ANNOUNCEMENT_TITLE]",
    "[AUTHOR_FIELD]",
    "[POSTED_AT]",
    "[BODY]",
    "[AUTHOR]",
    "[EMAIL]",
    "[PHONE]",
    "[URL]"
  ],
  "is_local": false,
  "local_files_only": true,
  "mask_token": "[MASK]",
  "model_max_length": 512,
  "pad_token": "[PAD]",
  "sep_token": "[SEP]",
  "strip_accents": null,
  "tokenize_chinese_chars": true,
  "tokenizer_class": "BertTokenizer",
  "unk_token": "[UNK]"
}
